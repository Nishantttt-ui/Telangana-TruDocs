# Copy this to .env for local overrides.  .env is gitignored — never commit it.

# Port uvicorn listens on (default 8000 in Docker; 8500 locally to avoid conflicts)
PORT=8000

# Uvicorn log level: debug | info | warning | error | critical
LOG_LEVEL=info

# Comma-separated allowed CORS origins.
# Dev: leave blank (localhost:5173 is always allowed).
# Prod: set to your Railway / Render / Vercel URL, e.g.:
#   CORS_ORIGINS=https://telangana-trudocs.up.railway.app
CORS_ORIGINS=
